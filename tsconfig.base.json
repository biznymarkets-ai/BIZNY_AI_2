{
  "compilerOptions": {
    "incremental": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": false,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "target": "es2022",
    "types": [],
    "customConditions": ["workspace"],
    "baseUrl": ".",
    "paths": {
      "@workspace/api-client-react": ["lib/lib/api-client-react/src/index.ts"],
      "@workspace/api-zod": ["lib/lib/api-zod/src/index.ts"],
      "@workspace/db": ["lib/lib/db/src/index.ts"],
      "@workspace/integrations-openai-ai-server": ["lib/lib/integrations-openai-ai-server/src/index.ts"],
      "@workspace/integrations-openai-ai-react": ["lib/lib/integrations-openai-ai-react/src/index.ts"]
    }
  }
}
