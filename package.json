{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/artifacts/*",
    "lib/lib/*",
    "scripts/scripts"
  ],
  "scripts": {
    "dev": "node server.ts",
    "build": "rm -rf dist && npm run build --workspace=@workspace/bizny && npm run build --workspace=@workspace/api-server && mkdir -p dist && cp -r artifacts/artifacts/bizny/dist/public dist/ && cp -r artifacts/artifacts/api-server/dist/. dist/",
    "start": "node server.ts",
    "lint": "tsc --build",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@google/genai": "^2.16.0",
    "@supabase/supabase-js": "^2.112.4",
    "esbuild": "^0.25.8",
    "firebase": "^12.17.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
